# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://voltechai:voltechai_secret@localhost:5432/voltechai"

# Used only by the local docker-compose PostgreSQL service.
POSTGRES_USER=voltechai
POSTGRES_PASSWORD=voltechai_secret
POSTGRES_DB=voltechai

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Get from: stripe listen --forward-to localhost:3001/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Frontend URL. Keep as localhost for dev.
FRONTEND_WEB_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3002

# ─── Admin authentication ──────────────────────────────────────────────────────
# Creates the initial OWNER only when this email does not already exist.
# Set both variables for the first deployment, sign in, then remove the password
# secret from Coolify after the owner account has been created.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# Opaque admin-session lifetime. Minimum 1 hour, maximum 168 hours.
ADMIN_SESSION_TTL_HOURS=12
