generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Service packages with authoritative pricing. Seeded from prisma/seed.ts.
model Package {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  amount    Int
  currency  String   @default("gbp")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([slug])
  @@map("packages")
}

/// Individual payment orders created when a checkout session is initiated.
model Order {
  id              String      @id @default(cuid())
  packageId       String
  amount          Int
  currency        String
  serviceName     String
  status          OrderStatus @default(PENDING)
  stripePaymentId String?     @unique
  stripeChargeId  String?     @unique
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  customerCountry String?
  cardBrand       String?
  cardLast4       String?
  receiptUrl      String?
  billingLine1    String?
  billingLine2    String?
  billingCity     String?
  billingState    String?
  billingPostalCode String?
  billingCountry  String?
  paymentDate     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  package         Package     @relation(fields: [packageId], references: [id])

  @@index([status])
  @@index([stripePaymentId])
  @@map("orders")
}

/// Idempotency log for processed Stripe webhook events.
/// Before handling any event, we check if event.id exists here.
/// This prevents double-processing when Stripe retries delivery.
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

enum OrderStatus {
  PENDING
  SUCCEEDED
  FAILED
}
