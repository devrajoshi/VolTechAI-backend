generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Service packages with authoritative pricing. Seeded from prisma/seed.ts.
model Package {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  amount    Int
  currency  String   @default("gbp")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([slug])
  @@map("packages")
}

/// Individual payment orders created when a checkout session is initiated.
model Order {
  id              String      @id @default(cuid())
  packageId       String
  amount          Int
  currency        String
  serviceName     String
  status          OrderStatus @default(PENDING)
  stripePaymentId String?     @unique
  stripeChargeId  String?     @unique
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  customerCountry String?
  cardBrand       String?
  cardLast4       String?
  receiptUrl      String?
  billingLine1    String?
  billingLine2    String?
  billingCity     String?
  billingState    String?
  billingPostalCode String?
  billingCountry  String?
  paymentDate     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  package         Package     @relation(fields: [packageId], references: [id])

  @@index([status])
  @@index([stripePaymentId])
  @@map("orders")
}

/// Idempotency log for processed Stripe webhook events.
/// Before handling any event, we check if event.id exists here.
/// This prevents double-processing when Stripe retries delivery.
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

/// Back-office identities. These accounts are intentionally separate from future
/// customer accounts so CMS permissions stay explicit and narrowly scoped.
model AdminUser {
  id                    String         @id @default(cuid())
  email                 String         @unique
  passwordHash          String
  role                  AdminRole      @default(EDITOR)
  isActive              Boolean        @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  sessions              AdminSession[]
  createdTestimonials   Testimonial[]  @relation("TestimonialCreatedBy")
  updatedTestimonials   Testimonial[]  @relation("TestimonialUpdatedBy")
  createdFaqs           Faq[]          @relation("FaqCreatedBy")
  updatedFaqs           Faq[]          @relation("FaqUpdatedBy")

  @@map("admin_users")
}

/// Opaque, revocable server sessions. Only a SHA-256 digest of the random token
/// is persisted, so a database leak cannot be used as a login credential.
model AdminSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Customer proof points shown on the public website when published.
model Testimonial {
  id          String     @id @default(cuid())
  seedKey     String?    @unique
  name        String
  role        String?
  company     String?
  quote       String
  rating      Int        @default(5)
  imagePath   String?
  isPublished Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   AdminUser? @relation("TestimonialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   AdminUser? @relation("TestimonialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@map("testimonials")
}

/// Frequently asked questions shown on the public website when published.
model Faq {
  id          String     @id @default(cuid())
  seedKey     String?    @unique
  question    String
  answer      String
  category    String?
  isPublished Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   AdminUser? @relation("FaqCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   AdminUser? @relation("FaqUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@map("faqs")
}


enum OrderStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum AdminRole {
  OWNER
  EDITOR
}
